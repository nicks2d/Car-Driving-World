[physics]

3d/physics_engine="Jolt Physics"
common/physics_interpolation=true

[shader_globals]

wetness={
"type": "float",
"value": 0.0
}
road_snow={
"type": "float",
"value": 0.0
}
snow_cover={
"type": "float",
"value": 0.0
}
snow_line={
"type": "float",
"value": 950.0
}
season_spring={
"type": "float",
"value": 0.0
}
season_autumn={
"type": "float",
"value": 0.0
}
season_winter={
"type": "float",
"value": 0.0
}
rain_amount={
"type": "float",
"value": 0.0
}
weather_wind={
"type": "float",
"value": 1.0
}
cloud_shadow={
"type": "float",
"value": 0.0
}
cloud_cover={
"type": "float",
"value": 0.3
}
cloud_offset={
"type": "vec2",
"value": Vector2(0, 0)
}
cloud_shadow_noise={
"type": "sampler2D",
"value": "res://assets/textures/cloud_shadows.tres"
}

[rendering]

textures/vram_compression/import_etc2_astc=true

scaling_3d/mode=4
scaling_3d/scale=0.75

[editor]

export/convert_text_resources_to_binary=false
